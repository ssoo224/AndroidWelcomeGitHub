<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp" android:layoutDirection="rtl"
    android:background="@drawable/bg_native_dialog">
    <TextView android:id="@+id/messageDeleteTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="حذف الرسالة" android:textColor="#F5D47B" android:textSize="19sp" android:textStyle="bold"/>
    <TextView android:id="@+id/messageDeleteDescription" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="اختر أين تريد حذف هذه الرسالة." android:textColor="#D5DCE5" android:textSize="13sp"/>
    <TextView android:id="@+id/messageDeleteForMe" android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginTop="14dp" android:gravity="center" android:text="حذف لدي فقط" android:textColor="#F1F5F9" android:textStyle="bold" android:background="@drawable/bg_native_cancel_button"/>
    <TextView android:id="@+id/messageDeleteForAll" android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginTop="8dp" android:gravity="center" android:text="حذف لدى الجميع" android:textColor="#FFFFFF" android:textStyle="bold" android:background="@drawable/bg_native_delete_button"/>
    <TextView android:id="@+id/messageDeleteCancel" android:layout_width="match_parent" android:layout_height="44dp"
        android:layout_marginTop="6dp" android:gravity="center" android:text="إلغاء" android:textColor="#F5D47B"/>
</LinearLayout>
