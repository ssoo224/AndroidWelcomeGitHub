<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/nativeSheetRoot" android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true" android:background="@drawable/bg_native_sheet" android:padding="18dp" android:layoutDirection="rtl">
 <LinearLayout android:id="@+id/storyComposerCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  <View android:layout_width="42dp" android:layout_height="4dp" android:layout_gravity="center_horizontal" android:background="@drawable/bg_gesture_handle" android:layout_marginBottom="16dp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
   <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="قصة جديدة" android:textColor="#F8FAFC" android:textSize="21sp" android:textStyle="bold"/>
   <TextView android:id="@+id/storyCancel" android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:text="✕" android:textColor="#CBD5E1" android:textSize="20sp" android:background="@drawable/bg_native_input"/>
  </LinearLayout>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="شارك لحظتك مع أصدقائك" android:textColor="#94A3B8" android:textSize="13sp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="وصف القصة (اختياري)" android:textColor="#E2E8F0" android:textStyle="bold" android:textSize="14sp"/>
  <EditText android:id="@+id/storyCaptionInput" android:layout_width="match_parent" android:layout_height="100dp" android:gravity="top|start" android:padding="13dp" android:layout_marginTop="8dp" android:background="@drawable/bg_native_input" android:textColor="#F8FAFC" android:hint="اكتب شيئاً عن قصتك..." android:textColorHint="#8795A7" android:maxLength="200" android:inputType="textMultiLine|textCapSentences"/>
  <TextView android:id="@+id/storyMediaPick" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center" android:layout_marginTop="12dp" android:text="＋  إضافة صورة أو فيديو" android:textColor="#E8C45B" android:textStyle="bold" android:background="@drawable/bg_native_input"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="مدة ظهور القصة" android:textColor="#E2E8F0" android:textStyle="bold" android:textSize="14sp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
   <TextView android:id="@+id/storyDuration24" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:gravity="center" android:text="24 ساعة" android:textColor="#17212B" android:textStyle="bold" android:background="@drawable/bg_native_chip"/>
   <TextView android:id="@+id/storyDuration12" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="center" android:text="12 ساعة" android:textColor="#E2E8F0" android:background="@drawable/bg_native_chip"/>
   <TextView android:id="@+id/storyDuration6" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="center" android:text="6 ساعات" android:textColor="#E2E8F0" android:background="@drawable/bg_native_chip"/>
  </LinearLayout>
  <CheckBox android:id="@+id/storyPinToggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="تثبيت بالملف الشخصي" android:textColor="#E2E8F0" android:buttonTint="#C29D30"/>
  <TextView android:id="@+id/storyPublish" android:layout_width="match_parent" android:layout_height="50dp" android:gravity="center" android:layout_marginTop="16dp" android:text="نشر القصة" android:textColor="#17212B" android:textStyle="bold" android:textSize="15sp" android:background="@drawable/bg_button"/>
 </LinearLayout>
</ScrollView>
