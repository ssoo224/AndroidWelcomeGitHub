<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:fillViewport="true" android:background="#F5F7FB">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp" android:background="#FFFFFF">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="قصة جديدة" android:textColor="#172033" android:textSize="21sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:text="شارك لحظتك مع أصدقائك" android:textColor="#7B8798" android:textSize="13sp" />
        <FrameLayout android:id="@+id/storyMediaPreview" android:layout_width="match_parent"
            android:layout_height="190dp" android:layout_marginTop="18dp" android:background="#EEF2F8">
            <TextView android:id="@+id/storyMediaHint" android:layout_width="match_parent"
                android:layout_height="match_parent" android:gravity="center" android:text="اختر صورة أو فيديو للقصة"
                android:textColor="#7B8798" android:textSize="14sp" />
        </FrameLayout>
        <Button android:id="@+id/storyPickMedia" android:layout_width="match_parent"
            android:layout_height="48dp" android:layout_marginTop="12dp" android:text="اختيار صورة أو فيديو" />
        <EditText android:id="@+id/storyCaption" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="88dp" android:gravity="top|start"
            android:layout_marginTop="12dp" android:hint="وصف القصة (اختياري)" android:maxLength="180"
            android:padding="12dp" android:background="#F3F5F9" android:textColor="#172033" />
        <TextView android:id="@+id/storyNativeNote" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="واجهة إنشاء القصة الأصلية — ربط النشر بالخادم غير مفعّل في هذه الدفعة."
            android:textColor="#8A94A4" android:textSize="11sp" />
    </LinearLayout>
</ScrollView>