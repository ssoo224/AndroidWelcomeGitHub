<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="22dp" android:layoutDirection="rtl"
    android:background="@drawable/bg_native_dialog">
    <TextView android:id="@+id/deleteDialogTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="حذف المحادثة" android:textColor="#F5D47B" android:textSize="19sp" android:textStyle="bold" />
    <TextView android:id="@+id/deleteDialogMessage" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:lineSpacingExtra="3dp" android:text="هل تريد حذف هذه المحادثة؟ لا يمكن التراجع عن هذا الإجراء."
        android:textColor="#E5E7EB" android:textSize="14sp" />
    <CheckBox android:id="@+id/deleteDialogBoth" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:buttonTint="#D8B34E" android:text="حذف أيضاً عند الطرف الآخر"
        android:textColor="#D1D5DB" android:textSize="13sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal">
        <TextView android:id="@+id/deleteDialogConfirm" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"
            android:gravity="center" android:text="حذف" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp"
            android:background="@drawable/bg_native_delete_button" />
        <TextView android:id="@+id/deleteDialogCancel" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"
            android:layout_marginStart="9dp" android:gravity="center" android:text="إلغاء" android:textColor="#F3D782" android:textStyle="bold" android:textSize="14sp"
            android:background="@drawable/bg_native_cancel_button" />
    </LinearLayout>
</LinearLayout>
