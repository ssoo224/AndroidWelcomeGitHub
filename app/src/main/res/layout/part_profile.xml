<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/partProfile"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:layoutDirection="rtl">

	<!-- ==================== صفحة الملف الشخصي (الخاص) ==================== -->
	<ScrollView
		android:id="@+id/profileView"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:visibility="gone"
		android:tag="bg"
		android:fillViewport="true">
		<LinearLayout
			android:id="@+id/linear641"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingBottom="32dp"
			android:orientation="vertical">

			<!-- الغلاف المتدرج -->
			<FrameLayout
				android:id="@+id/frame_layout642"
				android:layout_width="match_parent"
				android:layout_height="180dp"
				android:tag="cover_gradient">
				<!-- أزرار علوية وهمية لتطابق الصورة -->
				<TextView
					android:layout_width="48dp"
					android:layout_height="48dp"
					android:layout_margin="16dp"
					android:gravity="center"
					android:drawableStart="@drawable/ic_menu_20"
					android:textColor="#FFFFFF"
					android:tag="wh" />
			</FrameLayout>

			<!-- الصورة والاسم -->
			<LinearLayout
				android:id="@+id/linear643"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal"
				android:orientation="vertical"
				android:layout_marginTop="-60dp">

				<!-- الإطار الأبيض للصورة -->
				<FrameLayout
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:background="@android:color/white"
					android:padding="4dp"
					android:elevation="6dp"
					app:cardCornerRadius="50dp">
					<TextView
						android:id="@+id/pAvatarText"
						android:layout_width="120dp"
						android:layout_height="120dp"
						android:gravity="center"
						android:textSize="40sp"
						android:textStyle="bold"
						android:textColor="#17212B"
						android:tag="circ" />
				</FrameLayout>

				<!-- الاسم مع علامة التوثيق -->
				<LinearLayout
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/pHeaderName"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:textSize="24sp"
						android:textStyle="bold"
						android:tag="t" />
					<TextView
						android:id="@+id/pHeaderStatusIcon"
						android:layout_width="24dp"
						android:layout_height="24dp"
						android:layout_marginStart="6dp"
						android:gravity="center"
						android:drawableStart="@drawable/ic_check_double_16"
						android:tag="g" />
				</LinearLayout>

				<!-- حالة الاتصال -->
				<LinearLayout
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/pHeaderStatus"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="متصل الآن"
						android:textSize="13sp"
						android:textStyle="bold"
						android:tag="m" />
					<View
						android:layout_width="10dp"
						android:layout_height="10dp"
						android:layout_marginStart="6dp"
						android:background="@drawable/ic_circle_green"
						android:tag="green" />
				</LinearLayout>

				<!-- أزرار التحكم (تعديل، الصورة، الغلاف) -->
				<LinearLayout
					android:id="@+id/linear644"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="16dp"
					android:paddingStart="16dp"
					android:paddingEnd="16dp"
					android:weightSum="3"
					android:orientation="horizontal">

					<LinearLayout
						android:id="@+id/pEdit"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:layout_marginEnd="6dp"
						android:padding="12dp"
						android:gravity="center"
						android:orientation="vertical"
						android:background="@drawable/white_rounded"
						android:tag="white_card">
						<TextView
							android:layout_width="24dp"
							android:layout_height="24dp"
							android:gravity="center"
							android:drawableStart="@drawable/ic_edit_24"
							android:tag="g" />
						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="6dp"
							android:text="تعديل"
							android:textSize="13sp"
							android:textStyle="bold"
							android:tag="t" />
					</LinearLayout>

					<LinearLayout
						android:id="@+id/pPhoto"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:layout_marginStart="6dp"
						android:layout_marginEnd="6dp"
						android:padding="12dp"
						android:gravity="center"
						android:orientation="vertical"
						android:background="@drawable/white_rounded"
						android:tag="white_card">
						<TextView
							android:layout_width="24dp"
							android:layout_height="24dp"
							android:gravity="center"
							android:drawableStart="@drawable/ic_camera_24"
							android:tag="g" />
						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="6dp"
							android:text="الصورة"
							android:textSize="13sp"
							android:textStyle="bold"
							android:tag="t" />
					</LinearLayout>

					<LinearLayout
						android:id="@+id/pCover"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:layout_marginStart="6dp"
						android:padding="12dp"
						android:gravity="center"
						android:orientation="vertical"
						android:background="@drawable/white_rounded"
						android:tag="white_card">
						<TextView
							android:layout_width="24dp"
							android:layout_height="24dp"
							android:gravity="center"
							android:drawableStart="@drawable/ic_palette_24"
							android:tag="g" />
						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="6dp"
							android:text="الغلاف"
							android:textSize="13sp"
							android:textStyle="bold"
							android:tag="t" />
					</LinearLayout>
				</LinearLayout>
			</LinearLayout>

			<!-- كرت المعلومات -->
			<LinearLayout
				android:id="@+id/linear645"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:orientation="vertical"
				android:background="@drawable/white_rounded"
				android:elevation="4dp"
				android:layout_marginStart="16dp"
				android:layout_marginEnd="16dp">

				<!-- النبذة -->
				<LinearLayout
					android:id="@+id/pBioRow"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="16dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<TextView
						android:layout_width="44dp"
						android:layout_height="44dp"
						android:gravity="center"
						android:drawableStart="@drawable/ic_menu_20"
						android:tag="g"
						android:background="@drawable/icon_box_bg" />
					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:layout_weight="1"
						android:layout_marginStart="16dp"
						android:gravity="end">
						<TextView
							android:id="@+id/pBioDisplay"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="الشارع مالتي منو كال ملك عام"
							android:textSize="16sp"
							android:textStyle="bold"
							android:tag="t" />
						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="4dp"
							android:text="النبذة التعريفية"
							android:textSize="12sp"
							android:tag="m" />
					</LinearLayout>
				</LinearLayout>

				<View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F2F5" android:layout_marginStart="76dp" />

				<!-- اسم المستخدم -->
				<LinearLayout
					android:id="@+id/pUserRow"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="16dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<TextView
						android:layout_width="44dp"
						android:layout_height="44dp"
						android:gravity="center"
						android:text="@"
						android:textSize="22sp"
						android:textStyle="bold"
						android:tag="g"
						android:background="@drawable/icon_box_bg" />
					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:layout_weight="1"
						android:layout_marginStart="16dp"
						android:gravity="end">
						<TextView
							android:id="@+id/pHeaderUser"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:textSize="16sp"
							android:textStyle="bold"
							android:tag="t"
							android:textDirection="ltr" />
						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="4dp"
							android:text="اسم المستخدم (اضغط للنسخ)"
							android:textSize="12sp"
							android:tag="m" />
					</LinearLayout>
				</LinearLayout>

				<View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F2F5" android:layout_marginStart="76dp" />

				<!-- المحافظة -->
				<LinearLayout
					android:id="@+id/pGovRow"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="16dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<TextView
						android:layout_width="44dp"
						android:layout_height="44dp"
						android:gravity="center"
						android:drawableStart="@drawable/ic_pin_20"
						android:tag="g"
						android:background="@drawable/icon_box_bg" />
					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:layout_weight="1"
						android:layout_marginStart="16dp"
						android:gravity="end">
						<TextView
							android:id="@+id/pGovDisplay"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="المثنى"
							android:textSize="16sp"
							android:textStyle="bold"
							android:tag="t" />
						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="4dp"
							android:text="المحافظة"
							android:textSize="12sp"
							android:tag="m" />
					</LinearLayout>
				</LinearLayout>

				<View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F2F5" android:layout_marginStart="76dp" />

				<!-- تاريخ الانضمام -->
				<LinearLayout
					android:id="@+id/pJoinRow"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="16dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<TextView
						android:layout_width="44dp"
						android:layout_height="44dp"
						android:gravity="center"
						android:drawableStart="@drawable/ic_calendar_20"
						android:tag="g"
						android:background="@drawable/icon_box_bg" />
					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:layout_weight="1"
						android:layout_marginStart="16dp"
						android:gravity="end">
						<TextView
							android:id="@+id/pJoinDisplay"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="تشرين الأول ٢٠٢٦"
							android:textSize="16sp"
							android:textStyle="bold"
							android:tag="t" />
						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="4dp"
							android:text="تاريخ الانضمام"
							android:textSize="12sp"
							android:tag="m" />
					</LinearLayout>
				</LinearLayout>

				<View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F2F5" android:layout_marginStart="76dp" />

				<!-- البريد الإلكتروني -->
				<LinearLayout
					android:id="@+id/pEmailRow"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="16dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<TextView
						android:layout_width="44dp"
						android:layout_height="44dp"
						android:gravity="center"
						android:drawableStart="@drawable/ic_mail_20"
						android:tag="g"
						android:background="@drawable/icon_box_bg" />
					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:layout_weight="1"
						android:layout_marginStart="16dp"
						android:gravity="end">
						<TextView
							android:id="@+id/pEmailDisplay"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="hamodeygame45@gmail.com"
							android:textSize="16sp"
							android:textStyle="bold"
							android:tag="t"
							android:textDirection="ltr" />
						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="4dp"
							android:text="البريد الإلكتروني (ظاهر لك فقط)"
							android:textSize="12sp"
							android:tag="m" />
					</LinearLayout>
				</LinearLayout>
			</LinearLayout>

			<!-- عنوان قسم القصص -->
			<LinearLayout
				android:id="@+id/linear655"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:orientation="horizontal"
				android:layout_marginStart="16dp"
				android:layout_marginEnd="16dp">
				<TextView
					android:id="@+id/pTabStoriesBtn"
					android:layout_width="match_parent"
					android:layout_height="44dp"
					android:gravity="center"
					android:text="قصصي"
					android:drawableStart="@drawable/ic_history_18"
					android:drawablePadding="6dp"
					android:textSize="14sp"
					android:textStyle="bold"
					android:tag="m" />
			</LinearLayout>

			<LinearLayout
				android:id="@+id/pTabStories"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="16dp"
				android:orientation="vertical">
				<LinearLayout
					android:id="@+id/myStoriesGrid"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="horizontal" />
				<TextView
					android:id="@+id/myStoriesEmpty"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="10dp"
					android:text="ما عندك قصص. اضغط على صورتك حتى تنشر."
					android:textSize="13sp"
					android:textStyle="bold"
					android:tag="m" />
			</LinearLayout>
		</LinearLayout>
	</ScrollView>

	<!-- ==================== صفحة ملف مستخدم آخر ==================== -->
	<ScrollView
		android:id="@+id/otherUserProfileView"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:visibility="gone"
		android:tag="bg"
		android:fillViewport="true">
		<LinearLayout
			android:id="@+id/linear656"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingBottom="32dp"
			android:orientation="vertical">

			<FrameLayout
				android:id="@+id/frame_layout657"
				android:layout_width="match_parent"
				android:layout_height="150dp"
				android:tag="cover_gradient">
				<TextView
					android:id="@+id/otherBack"
					android:layout_width="56dp"
					android:layout_height="56dp"
					android:gravity="center"
					android:drawableStart="@drawable/ic_arrow_back_24"
					android:textSize="24sp"
					android:textColor="#FFFFFF"
					android:tag="wh"
					android:layout_margin="4dp" />
				<TextView
					android:id="@+id/otherMoreBtn"
					android:layout_width="56dp"
					android:layout_height="56dp"
					android:gravity="center"
					android:drawableStart="@drawable/ic_more_22"
					android:textSize="24sp"
					android:textColor="#FFFFFF"
					android:layout_gravity="end"
					android:tag="wh"
					android:layout_margin="4dp" />
			</FrameLayout>

			<LinearLayout
				android:id="@+id/linear658"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal"
				android:orientation="vertical"
				android:layout_marginTop="-48dp">

				<FrameLayout
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:background="@android:color/white"
					android:padding="4dp"
					android:elevation="6dp"
					app:cardCornerRadius="50dp">
					<TextView
						android:id="@+id/otherAvatarText"
						android:layout_width="92dp"
						android:layout_height="92dp"
						android:gravity="center"
						android:textSize="34sp"
						android:textStyle="bold"
						android:textColor="#17212B"
						android:tag="circ" />
				</FrameLayout>

				<TextView
					android:id="@+id/otherHeaderName"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="10dp"
					android:textSize="22sp"
					android:textStyle="bold"
					android:tag="t" />

				<TextView
					android:id="@+id/otherHeaderStatus"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="3dp"
					android:textSize="13sp"
					android:textStyle="bold"
					android:tag="m" />

				<TextView
					android:id="@+id/otherHeaderUser"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:textSize="14sp"
					android:textStyle="bold"
					android:tag="m"
					android:textDirection="ltr" />

				<LinearLayout
					android:id="@+id/linear659"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="14dp"
					android:gravity="center"
					android:orientation="horizontal">

					<TextView
						android:id="@+id/otherMsgBtn"
						android:layout_width="wrap_content"
						android:layout_height="44dp"
						android:gravity="center"
						android:text="رسالة"
						android:drawableStart="@drawable/ic_chat_16"
						android:drawablePadding="6dp"
						android:textSize="14sp"
						android:textStyle="bold"
						android:paddingStart="22dp"
						android:paddingEnd="22dp"
						android:layout_marginStart="4dp"
						android:layout_marginEnd="4dp"
						android:tag="gold" />

					<TextView
						android:id="@+id/otherBlockBtn"
						android:layout_width="wrap_content"
						android:layout_height="44dp"
						android:gravity="center"
						android:text="حظر"
						android:drawableStart="@drawable/ic_block_16"
						android:drawablePadding="6dp"
						android:textSize="14sp"
						android:textStyle="bold"
						android:paddingStart="18dp"
						android:paddingEnd="18dp"
						android:layout_marginStart="4dp"
						android:layout_marginEnd="4dp"
						android:tag="redo" />
				</LinearLayout>
			</LinearLayout>

			<!-- كرت المعلومات لمستخدم آخر -->
			<LinearLayout
				android:id="@+id/linear660"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:orientation="vertical"
				android:background="@drawable/white_rounded"
				android:elevation="4dp"
				android:layout_marginStart="16dp"
				android:layout_marginEnd="16dp">

				<LinearLayout
					android:id="@+id/otherBioRow"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="16dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<TextView
						android:layout_width="44dp"
						android:layout_height="44dp"
						android:gravity="center"
						android:drawableStart="@drawable/ic_menu_20"
						android:tag="g"
						android:background="@drawable/icon_box_bg" />
					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:layout_weight="1"
						android:layout_marginStart="16dp"
						android:gravity="end">
						<TextView
							android:id="@+id/otherBioDisplay"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:textSize="16sp"
							android:textStyle="bold"
							android:tag="t" />
						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="4dp"
							android:text="النبذة التعريفية"
							android:textSize="12sp"
							android:tag="m" />
					</LinearLayout>
				</LinearLayout>

				<View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F2F5" android:layout_marginStart="76dp" />

				<LinearLayout
					android:id="@+id/otherUserRow"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="16dp"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<TextView
						android:layout_width="44dp"
						android:layout_height="44dp"
						android:gravity="center"
						android:text="@"
						android:textSize="22sp"
						android:textStyle="bold"
						android:tag="g"
						android:background="@drawable/icon_box_bg" />
					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:layout_weight="1"
						android:layout_marginStart="16dp"
						android:gravity="end">
						<TextView
							android:id="@+id/otherHeaderUser2"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:textSize="16sp"
							android:textStyle="bold"
