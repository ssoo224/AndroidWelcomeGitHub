<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/nativeAvatarGallery" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="18dp" android:gravity="center" android:background="#080D14" android:layoutDirection="rtl">
 <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="الصورة الشخصية" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/><TextView android:id="@+id/avatarGalleryClose" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="✕" android:textColor="#FFFFFF" android:textSize="22sp"/></LinearLayout>
 <ImageView android:id="@+id/avatarGalleryImage" android:layout_width="280dp" android:layout_height="280dp" android:layout_marginTop="22dp" android:scaleType="centerCrop" android:background="@drawable/bg_pf_round" android:contentDescription="الصورة الشخصية"/>
 <TextView android:id="@+id/avatarGalleryInitial" android:layout_width="280dp" android:layout_height="280dp" android:layout_marginTop="-280dp" android:gravity="center" android:text="؟" android:textColor="#17212B" android:textSize="70sp" android:textStyle="bold" android:background="@drawable/bg_pf_round"/>
