 <TextView android:id="@+id/avatarGalleryDelete" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:gravity="center" android:text="حذف الصورة الحالية" android:textColor="#F87171" android:textSize="14sp"/>
