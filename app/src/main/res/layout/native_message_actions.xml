<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/nativeMessageActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_native_sheet" android:layoutDirection="rtl">
 <View android:layout_width="42dp" android:layout_height="4dp" android:layout_gravity="center_horizontal" android:background="@drawable/bg_gesture_handle" android:layout_marginBottom="14dp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:orientation="horizontal" android:gravity="center">
  <TextView android:id="@+id/msgReactLaugh" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:gravity="center" android:text="😂" android:textSize="25sp"/>
  <TextView android:id="@+id/msgReactHeart" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:gravity="center" android:text="❤️" android:textSize="25sp"/>
  <TextView android:id="@+id/msgReactLike" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:gravity="center" android:text="👍" android:textSize="25sp"/>
  <TextView android:id="@+id/msgReactSad" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:gravity="center" android:text="😭" android:textSize="25sp"/>
  <TextView android:id="@+id/msgReactSpark" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:gravity="center" android:text="✨" android:textSize="25sp"/>
 </LinearLayout>
 <TextView android:id="@+id/msgActionReply" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingStart="14dp" android:text="↩   الرد على الرسالة" android:textColor="#F1F5F9" android:textSize="14sp"/>
 <TextView android:id="@+id/msgActionCopy" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingStart="14dp" android:text="▣   نسخ النص" android:textColor="#F1F5F9" android:textSize="14sp"/>
 <TextView android:id="@+id/msgActionEdit" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingStart="14dp" android:text="✎   تعديل الرسالة" android:textColor="#F1F5F9" android:textSize="14sp"/>
 <TextView android:id="@+id/msgActionDelete" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingStart="14dp" android:text="⌫   حذف الرسالة" android:textColor="#F87171" android:textSize="14sp"/>
 <TextView android:id="@+id/msgActionCancel" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center" android:text="إلغاء" android:textColor="#94A3B8" android:textSize="13sp"/>
</LinearLayout>
