<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="18dp" android:background="#FFFFFF">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="خيارات الرسالة" android:textSize="18sp" android:textStyle="bold" android:textColor="#172033" android:paddingBottom="12dp" />
    <TextView android:id="@+id/msgActionReply" android:layout_width="match_parent" android:layout_height="48dp"
        android:gravity="center_vertical" android:drawablePadding="12dp" android:paddingHorizontal="12dp"
        android:text="رد على الرسالة" android:textSize="15sp" android:textColor="#172033" android:background="#F5F7FB" />
    <TextView android:id="@+id/msgActionCopy" android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginTop="7dp" android:gravity="center_vertical" android:paddingHorizontal="12dp"
        android:text="نسخ النص" android:textSize="15sp" android:textColor="#172033" android:background="#F5F7FB" />
    <TextView android:id="@+id/msgActionEdit" android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginTop="7dp" android:gravity="center_vertical" android:paddingHorizontal="12dp"
        android:text="تعديل الرسالة" android:textSize="15sp" android:textColor="#172033" android:background="#F5F7FB" />
    <TextView android:id="@+id/msgActionDelete" android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginTop="7dp" android:gravity="center_vertical" android:paddingHorizontal="12dp"
        android:text="حذف الرسالة" android:textSize="15sp" android:textColor="#D04444" android:background="#FFF2F2" />
</LinearLayout>