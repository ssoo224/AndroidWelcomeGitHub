<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:layoutDirection="rtl"
	android:fitsSystemWindows="true"
	android:tag="bg">
	<LinearLayout
		android:id="@+id/mainPage"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical"
		android:tag="bg">
		<LinearLayout
			android:id="@+id/mainHeader"
			android:layoutDirection="ltr"
			android:layout_width="match_parent"
			android:layout_height="62dp"
			android:clipChildren="false"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:paddingStart="16dp"
			android:paddingEnd="16dp"
			android:tag="bg">
			<TextView
				android:id="@+id/mainSearchBtn"
				android:layout_width="42dp"
				android:layout_height="42dp"
				android:gravity="center_horizontal|center_vertical"
				android:text=""
				android:drawableStart="@drawable/ic_search_22"
				android:textSize="19sp"
				android:elevation="0dp"
				android:tag="card t" />
			<LinearLayout
				android:id="@+id/hdrStories"
				android:layout_width="wrap_content"
				android:layout_height="54dp"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:layout_marginStart="4.7dp"
				android:clipChildren="false"
				android:clipToPadding="false"
				android:clickable="true"
				android:focusable="true"
				android:contentDescription="القصص" />
			<TextView
				android:id="@+id/textview621"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:text="Babylon Chat"
				android:textSize="23sp"
				android:textStyle="bold"
				android:layout_weight="1"
				android:gravity="right|center_vertical"
				android:textAlignment="gravity"
				android:tag="g" />
		</LinearLayout>
		<FrameLayout
			android:id="@+id/pagesHost"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1">
			<com.babylon.chat.iq.StoriesHost
				android:id="@+id/homeView"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:orientation="vertical"
				android:tag="bg homepat">
				<ScrollView
					android:id="@+id/vscroll39"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:scrollbars="none"
					android:clipChildren="false"
					android:fillViewport="true">
					<LinearLayout
						android:id="@+id/homeContent"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:clipChildren="false">
						<LinearLayout
							android:id="@+id/topStories"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:orientation="vertical"
							android:visibility="gone"
							android:clipChildren="false"
							android:tag="bg">
							<HorizontalScrollView
								android:id="@+id/storiesScroll"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:layoutDirection="ltr"
								android:clipChildren="false"
								android:overScrollMode="never"
								android:scrollbars="none">
								<LinearLayout
									android:id="@+id/storiesBar"
									android:layout_width="wrap_content"
									android:layout_height="match_parent"
									android:layoutDirection="ltr"
									android:clipChildren="false"
									android:paddingStart="14dp"
									android:paddingEnd="14dp"
									android:paddingTop="12dp"
									android:paddingBottom="10dp"
									android:orientation="horizontal" />
							</HorizontalScrollView>
						</LinearLayout>
						<LinearLayout
							android:id="@+id/chatFilters"
							android:layout_width="match_parent"
							android:visibility="gone"
							android:layout_height="wrap_content"
							android:paddingTop="12dp"
							android:paddingBottom="12dp"
							android:orientation="horizontal"
							android:clipChildren="false"
							android:paddingStart="16dp"
							android:paddingEnd="16dp">
							<TextView
								android:id="@+id/fltAll"
								android:layout_width="wrap_content"
								android:layout_height="35dp"
								android:gravity="center"
								android:text="الكل"
								android:textSize="14sp"
								android:textStyle="bold"
								android:paddingStart="16dp"
								android:paddingEnd="16dp"
								android:tag="gold" />
							<FrameLayout
								android:layout_width="wrap_content"
								android:layout_height="35dp"
								android:layout_marginStart="8dp"
								android:clipChildren="false">
								<TextView
									android:id="@+id/fltUnread"
									android:layout_width="wrap_content"
									android:layout_height="35dp"
									android:gravity="center"
									android:text="غير المقروءة"
									android:textSize="14sp"
									android:textStyle="bold"
									android:paddingStart="16dp"
									android:paddingEnd="16dp"
									android:tag="goldo" />
								<TextView
									android:id="@+id/fltUnreadCnt"
									android:layout_width="wrap_content"
									android:layout_height="23dp"
									android:minWidth="23dp"
									android:layout_gravity="top|start"
									android:layout_marginStart="-6dp"
									android:layout_marginTop="-9dp"
									android:gravity="center"
									android:paddingStart="6dp"
									android:paddingEnd="6dp"
									android:textSize="12sp"
									android:textStyle="bold"
									android:textColor="#FFFFFF"
									android:visibility="gone" />
							</FrameLayout>
						</LinearLayout>
						<LinearLayout
							android:id="@+id/chatList"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:paddingStart="12dp"
							android:paddingEnd="12dp"
							android:paddingTop="8dp"
							android:paddingBottom="88dp"
							android:clipChildren="false"
							android:clipToPadding="false"
							android:orientation="vertical" />
					</LinearLayout>
				</ScrollView>
			</com.babylon.chat.iq.StoriesHost>
			<TextView
				android:id="@+id/newGroupFab"
				android:layout_width="58dp"
				android:layout_height="58dp"
				android:layout_margin="16dp"
				android:gravity="center_horizontal|center_vertical"
				android:text=""
				android:drawableStart="@drawable/ic_group_24"
				android:textSize="22sp"
				android:textColor="#FFFFFF"
				android:layout_gravity="bottom|left"
				android:elevation="0dp"
				android:tag="fab" />
			<LinearLayout
				android:id="@+id/searchView"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:orientation="vertical"
				android:visibility="gone">
				<!-- الهيدر العلوي: خلفية متدرجة بحواف سفلية 30dp + ظل (تُضبط ألوانه في SearchPage) -->
				<LinearLayout
					android:id="@+id/searchTop"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:paddingLeft="14dp"
					android:paddingRight="14dp"
					android:paddingTop="14dp"
					android:paddingBottom="16dp">
					<LinearLayout
						android:id="@+id/linear605"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginBottom="14dp"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<FrameLayout
							android:id="@+id/searchBack"
							android:layout_width="42dp"
							android:layout_height="42dp"
							android:clickable="true"
							android:focusable="true"
							android:contentDescription="رجوع">
							<ImageView
								android:id="@+id/searchBackIcon"
								android:layout_width="22dp"
								android:layout_height="22dp"
								android:layout_gravity="center"
								android:importantForAccessibility="no"
								android:src="@drawable/ic_sr_back" />
						</FrameLayout>
						<TextView
							android:id="@+id/textview622"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginStart="10dp"
							android:text="بحث المستخدمين"
							android:textSize="19sp"
							android:textStyle="bold" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/searchField"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:minHeight="52dp"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:paddingLeft="18dp"
						android:paddingRight="8dp">
						<ImageView
							android:id="@+id/searchFieldIcon"
							android:layout_width="20dp"
							android:layout_height="20dp"
							android:importantForAccessibility="no"
							android:src="@drawable/ic_sr_search" />
						<EditText
							android:id="@+id/searchInput"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:layout_marginStart="10dp"
							android:layout_marginEnd="10dp"
							android:background="@null"
							android:gravity="center_vertical|start"
							android:hint="ابحث بـ \@username"
							android:imeOptions="actionSearch"
							android:inputType="textNoSuggestions"
							android:paddingTop="12dp"
							android:paddingBottom="12dp"
							android:paddingLeft="0dp"
							android:paddingRight="0dp"
							android:singleLine="true"
							android:textAlignment="viewStart"
							android:textDirection="rtl"
							android:textSize="15sp" />
						<FrameLayout
							android:id="@+id/searchClearBtn"
							android:layout_width="26dp"
							android:layout_height="26dp"
							android:clickable="true"
							android:focusable="true"
							android:visibility="gone"
							android:contentDescription="مسح البحث">
							<ImageView
								android:id="@+id/searchClearIcon"
								android:layout_width="13dp"
								android:layout_height="13dp"
								android:layout_gravity="center"
								android:importantForAccessibility="no"
								android:src="@drawable/ic_sr_clear" />
						</FrameLayout>
					</LinearLayout>
					<TextView
						android:id="@+id/searchHint"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginStart="6dp"
						android:layout_marginEnd="6dp"
						android:layout_marginTop="10dp"
						android:minHeight="16dp"
						android:text="اكتب 3 أحرف على الأقل"
						android:textSize="12sp" />
				</LinearLayout>
				<ScrollView
					android:id="@+id/vscroll40"
					android:layout_width="match_parent"
					android:layout_height="0dp"
					android:layout_weight="1"
					android:clipToPadding="false"
					android:overScrollMode="ifContentScrolls"
					android:scrollbars="none">
					<LinearLayout
						android:id="@+id/searchResults"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:paddingLeft="12dp"
						android:paddingTop="16dp"
						android:paddingRight="12dp"
						android:paddingBottom="26dp" />
				</ScrollView>
			</LinearLayout>
		</FrameLayout>
		<LinearLayout
			android:id="@+id/bottomNav"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:tag="navbg"
			android:elevation="0dp">
			<View
				android:id="@+id/bottomNavLine"
				android:layout_width="match_parent"
				android:layout_height="1dp"
				android:tag="navline" />
			<LinearLayout
				android:id="@+id/bottomNavRow"
				android:layoutDirection="ltr"
				android:layout_width="match_parent"
				android:layout_height="57dp"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:paddingStart="10dp"
				android:paddingEnd="10dp"
				android:paddingTop="6dp"
				android:paddingBottom="6dp">
			<LinearLayout
				android:id="@+id/navProfile"
				android:layout_width="0dp"
				android:layout_height="match_parent"
				android:layout_weight="1"
				android:layout_marginStart="3dp"
				android:layout_marginEnd="3dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical"
				android:clickable="true"
				android:focusable="true">
				<TextView
					android:id="@+id/navProfileIc"
					android:layout_width="54dp"
					android:layout_height="26dp"
					android:gravity="center_horizontal|center_vertical"
					android:text=""
					android:drawableStart="@drawable/ic_nav_user"
					android:textSize="20sp"
					android:tag="m" />
				<TextView
					android:id="@+id/navProfileTx"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:text="الملف الشخصي"
					android:textSize="11sp"
					android:textStyle="bold"
					android:tag="m" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/navSettings"
				android:layout_width="0dp"
				android:layout_height="match_parent"
				android:layout_weight="1"
				android:layout_marginStart="3dp"
				android:layout_marginEnd="3dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical"
				android:clickable="true"
				android:focusable="true">
				<TextView
					android:id="@+id/navSettingsIc"
					android:layout_width="54dp"
					android:layout_height="26dp"
					android:gravity="center_horizontal|center_vertical"
					android:text=""
					android:drawableStart="@drawable/ic_nav_sliders"
					android:textSize="20sp"
					android:tag="m" />
				<TextView
					android:id="@+id/navSettingsTx"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:text="الإعدادات"
					android:textSize="11sp"
					android:textStyle="bold"
					android:tag="m" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/navChats"
				android:layout_width="0dp"
				android:layout_height="match_parent"
				android:layout_weight="1"
				android:layout_marginStart="3dp"
				android:layout_marginEnd="3dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical"
				android:clickable="true"
				android:focusable="true">
				<TextView
					android:id="@+id/navChatsIc"
					android:layout_width="54dp"
					android:layout_height="26dp"
					android:gravity="center_horizontal|center_vertical"
					android:text=""
					android:drawableStart="@drawable/ic_nav_chat"
					android:textSize="20sp"
					android:tag="m" />
				<TextView
					android:id="@+id/navChatsTx"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:text="المحادثات"
					android:textSize="11sp"
					android:textStyle="bold"
					android:tag="m" />
			</LinearLayout>
			</LinearLayout>
		</LinearLayout>
	</LinearLayout>
	<FrameLayout
		android:id="@+id/chatView"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:visibility="gone"
		android:tag="bg">
		<ScrollView
 android:scrollbars="none"
			android:id="@+id/messagesScroll"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:clipToPadding="false"
			android:fillViewport="true"
			android:tag="chatbg chatpat">
			<LinearLayout
				android:id="@+id/messagesArea"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="10dp"
				android:gravity="bottom"
				android:orientation="vertical" />
		</ScrollView>
		<LinearLayout
			android:id="@+id/chatTopBar"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_gravity="top"
			android:orientation="vertical"
			android:tag="glasst">
			<LinearLayout
				android:id="@+id/linear607"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:paddingStart="10dp"
				android:paddingEnd="10dp"
				android:paddingBottom="6dp">
				<TextView
					android:id="@+id/chatBack"
					android:layout_width="38dp"
					android:layout_height="38dp"
					android:gravity="center"
					android:text=""
					android:drawableStart="@drawable/ic_arrow_left_24"
					android:textSize="22sp"
					android:elevation="0dp"
					android:tag="rbtn t" />
				<LinearLayout
					android:id="@+id/chatUserInfo"
					android:layout_width="0dp"
					android:layout_height="48dp"
					android:layout_weight="1"
					android:layout_marginStart="8dp"
					android:layout_marginEnd="8dp"
					android:paddingStart="8dp"
					android:paddingEnd="14dp"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:elevation="0dp"
					android:tag="pill">
					<TextView
						android:id="@+id/chatAvatar"
						android:layout_width="40dp"
						android:layout_height="40dp"
						android:gravity="center_horizontal|center_vertical"
						android:text="؟"
						android:textSize="16sp"
						android:textStyle="bold"
						android:textColor="#17212B"
						android:tag="circ" />
					<LinearLayout
						android:id="@+id/linear608"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:layout_marginStart="10dp">
						<TextView
							android:id="@+id/chatTitle"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="المحادثة"
							android:textSize="16sp"
							android:textStyle="bold"
							android:tag="t" />
						<TextView
							android:id="@+id/chatSub"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="غير متصل"
							android:textSize="12sp"
							android:tag="m" />
					</LinearLayout>
				</LinearLayout>
				<TextView
					android:id="@+id/chatMore"
					android:layout_width="38dp"
					android:layout_height="38dp"
					android:gravity="center"
					android:text=""
					android:drawableStart="@drawable/ic_more_22"
					android:textSize="22sp"
					android:elevation="0dp"
					android:tag="rbtn t" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/chatSearchPanel"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="10dp"
				android:orientation="vertical"
				android:visibility="gone"
				android:tag="sf">
				<LinearLayout
					android:id="@+id/linear609"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<EditText
						android:id="@+id/chatMessageSearchInput"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:textSize="14sp"
						android:hint="ابحث في هذه المحادثة..."
						android:singleLine="true"
						android:layout_weight="1"
						android:minHeight="48dp"
						android:paddingStart="14dp"
						android:paddingEnd="14dp"
						android:tag="inp" />
					<TextView
						android:id="@+id/csX"
						android:layout_width="44dp"
						android:layout_height="44dp"
						android:gravity="center_horizontal|center_vertical"
						android:text=""
						android:drawableStart="@drawable/ic_close_22"
						android:textSize="20sp"
						android:tag="t" />
				</LinearLayout>
				<TextView
					android:id="@+id/csCount"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:textSize="12sp"
					android:tag="m" />
			</LinearLayout>
		</LinearLayout>
		<LinearLayout
			android:id="@+id/chatBottomBar"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_gravity="bottom"
			android:orientation="vertical"
			android:tag="glassb">
			<LinearLayout
				android:id="@+id/replyPreviewBar"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginStart="8dp"
				android:layout_marginEnd="8dp"
				android:layout_marginTop="6dp"
				android:layout_marginBottom="4dp"
				android:paddingStart="14dp"
				android:paddingEnd="14dp"
				android:paddingTop="9dp"
				android:paddingBottom="9dp"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:visibility="gone"
				android:tag="rpBar">
				<TextView
					android:id="@+id/replyCancel"
					android:layout_width="30dp"
					android:layout_height="30dp"
					android:gravity="center_horizontal|center_vertical"
					android:text=""
					android:drawableStart="@drawable/ic_close_16"
					android:textSize="16sp"
					android:layout_marginEnd="10dp"
					android:tag="rpCancel" />
				<LinearLayout
					android:id="@+id/linear610"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:orientation="horizontal"
					android:layout_weight="1"
					android:tag="rpContent">
					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:layout_weight="1">
						<TextView
							android:id="@+id/replyLabel"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="الرد على الرسالة"
							android:drawableEnd="@drawable/ic_reply_16"
							android:drawablePadding="5dp"
							android:gravity="right|center_vertical"
							android:layout_marginBottom="2dp"
							android:textSize="11sp"
							android:textStyle="bold"
							android:tag="rpLabel" />
						<TextView
							android:id="@+id/replyPreviewText"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="..."
							android:gravity="right"
							android:textSize="13sp"
							android:textStyle="bold"
							android:tag="rpMsg"
							android:maxLines="1"
							android:ellipsize="end" />
					</LinearLayout>
				</LinearLayout>
			</LinearLayout>
			<LinearLayout
				android:id="@+id/recordingBar"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginStart="10dp"
				android:layout_marginEnd="10dp"
				android:layout_marginTop="4dp"
				android:layout_marginBottom="0dp"
				android:minHeight="66dp"
				android:paddingStart="12dp"
				android:paddingEnd="12dp"
				android:paddingTop="8dp"
				android:paddingBottom="8dp"
				android:gravity="center_vertical"
				android:layoutDirection="ltr"
				android:orientation="horizontal"
				android:visibility="gone"
				android:tag="recbar">
				<!-- الترتيب الظاهري (يسار ← يمين) مطابق لـ HTML بالـ RTL: إيقاف/إرسال، منطقة الموجة، ثم عمود التشغيل/الإلغاء -->
				<TextView
					android:id="@+id/recStop"
					android:layout_width="42dp"
					android:layout_height="42dp"
					android:gravity="center"
					android:text=""
					android:drawableStart="@drawable/ic_rec_stop"
					android:textSize="18sp"
					android:tag="recbtn" />
				<TextView
					android:id="@+id/recSend"
					android:layout_width="42dp"
					android:layout_height="42dp"
					android:gravity="center"
					android:text=""
					android:drawableStart="@drawable/ic_rec_send"
					android:textSize="21sp"
					android:visibility="gone"
					android:tag="recbtn" />
				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:layout_marginStart="12dp"
					android:layout_marginEnd="12dp"
					android:orientation="vertical">
					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:orientation="horizontal">
						<TextView
							android:id="@+id/recTimer"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:gravity="start"
							android:text="00:00"
							android:textSize="12sp"
							android:tag="m" />
						<TextView
							android:id="@+id/recLabel"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginEnd="7dp"
							android:text="جاري التسجيل"
							android:textSize="12sp"
							android:textStyle="bold" />
						<View
							android:id="@+id/recDot"
							android:layout_width="7dp"
							android:layout_height="7dp" />
					</LinearLayout>
					<LinearLayout
						android:id="@+id/recWave"
						android:layout_width="match_parent"
						android:layout_height="33dp"
						android:layout_marginTop="4dp"
						android:gravity="right|center_vertical"
						android:clipChildren="true"
						android:orientation="horizontal" />
				</LinearLayout>
				<LinearLayout
					android:layout_width="38dp"
					android:layout_height="wrap_content"
					android:paddingTop="5dp"
					android:paddingBottom="3dp"
					android:gravity="center"
					android:orientation="vertical"
					android:tag="recleft">
					<TextView
						android:id="@+id/recPlay"
						android:layout_width="38dp"
						android:layout_height="23dp"
						android:gravity="center"
						android:text=""
						android:drawableStart="@drawable/ic_rec_play"
						android:textSize="18sp"
						android:visibility="gone"
						android:tag="wh" />
					<TextView
						android:id="@+id/recCancel"
						android:layout_width="38dp"
						android:layout_height="36dp"
						android:gravity="center"
						android:includeFontPadding="false"
						android:text="×"
						android:textSize="26sp"
						android:tag="wh" />
				</LinearLayout>
			</LinearLayout>
			<LinearLayout
				android:id="@+id/textInputBar"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginStart="4dp"
				android:layout_marginEnd="4dp"
				android:layout_marginTop="4dp"
				android:layout_marginBottom="0dp"
				android:minHeight="48dp"
				android:paddingStart="8dp"
				android:paddingEnd="8dp"
				android:paddingTop="5dp"
				android:paddingBottom="5dp"
				android:gravity="bottom"
				android:layoutDirection="ltr"
				android:orientation="horizontal"
				android:tag="composer"
				android:elevation="0dp"
				android:stateListAnimator="@null">
				<!-- الترتيب الظاهري (يسار ← يمين) مطابق لـ HTML بالـ RTL: إرسال، مايك، مرفقات، ثم الحقل في أقصى اليمين -->
				<TextView
					android:id="@+id/btnSend"
					android:layout_width="40dp"
					android:layout_height="40dp"
					android:layout_gravity="top"
					android:layout_marginEnd="6dp"
					android:gravity="center_horizontal|center_vertical"
					android:text=""
					android:drawableStart="@drawable/ic_send_up_21"
					android:textSize="21sp"
					android:visibility="gone"
					android:tag="sendbtn" />
				<TextView
					android:id="@+id/btnMic"
					android:layout_width="40dp"
					android:layout_height="40dp"
					android:layout_marginEnd="6dp"
					android:gravity="center_horizontal|center_vertical"
					android:text=""
					android:drawableStart="@drawable/ic_mic_22"
					android:textSize="20sp"
					android:tag="m" />
				<TextView
					android:id="@+id/btnAttach"
					android:layout_width="40dp"
					android:layout_height="40dp"
					android:layout_marginEnd="6dp"
					android:gravity="center_horizontal|center_vertical"
					android:text=""
					android:drawableStart="@drawable/ic_attach_22"
					android:textSize="20sp"
					android:tag="m" />
				<com.babylon.chat.iq.RichEditText
					android:id="@+id/messageInput"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:textSize="15sp"
					android:hint="اكتب رسالتك..."
					android:inputType="textMultiLine|textCapSentences"
					android:minHeight="45dp"
					android:maxHeight="137dp"
					android:gravity="center_vertical|start"
					android:textDirection="firstStrong"
					android:textAlignment="textStart"
					android:paddingStart="12dp"
					android:paddingEnd="12dp"
					android:paddingTop="9dp"
					android:paddingBottom="9dp"
					android:tag="msginp" />
			</LinearLayout>
			</LinearLayout>
	</FrameLayout>
</FrameLayout>
