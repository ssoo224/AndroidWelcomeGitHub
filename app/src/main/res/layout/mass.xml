<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:layoutDirection="rtl"
	android:fitsSystemWindows="true"
	android:tag="bg">
	<LinearLayout
		android:id="@+id/mainPage"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical"
		android:tag="bg">
		<LinearLayout
			android:id="@+id/mainHeader"
			android:layout_width="match_parent"
			android:layout_height="62dp"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:paddingStart="16dp"
			android:paddingEnd="16dp"
			android:tag="bg">
			<TextView
				android:id="@+id/textview621"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:text="Babylon Chat"
				android:textSize="23sp"
				android:textStyle="bold"
				android:layout_weight="1"
				android:tag="g" />
			<TextView
				android:id="@+id/hdrStories"
				android:layout_width="42dp"
				android:layout_height="42dp"
				android:gravity="center_horizontal|center_vertical"
				android:text=""
				android:drawableStart="@drawable/ic_stories_24"
				android:textSize="20sp"
				android:layout_marginStart="8dp"
				android:elevation="2dp"
				android:tag="card t" />
			<TextView
				android:id="@+id/mainSearchBtn"
				android:layout_width="42dp"
				android:layout_height="42dp"
				android:gravity="center_horizontal|center_vertical"
				android:text=""
				android:drawableStart="@drawable/ic_search_22"
				android:textSize="19sp"
				android:layout_marginStart="8dp"
				android:elevation="2dp"
				android:tag="card t" />
		</LinearLayout>
		<FrameLayout
			android:id="@+id/pagesHost"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1">
			<LinearLayout
				android:id="@+id/homeView"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:orientation="vertical"
				android:tag="bg homepat">
				<HorizontalScrollView
					android:id="@+id/storiesScroll"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:scrollbars="none">
					<LinearLayout
						android:id="@+id/storiesBar"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:paddingStart="14dp"
						android:paddingEnd="14dp"
						android:paddingTop="12dp"
						android:paddingBottom="10dp"
						android:orientation="horizontal" />
				</HorizontalScrollView>
				<LinearLayout
					android:id="@+id/chatFilters"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingTop="4dp"
					android:paddingBottom="12dp"
					android:orientation="horizontal"
					android:paddingStart="16dp"
					android:paddingEnd="16dp">
					<TextView
						android:id="@+id/fltAll"
						android:layout_width="wrap_content"
						android:layout_height="38dp"
						android:gravity="center_horizontal|center_vertical"
						android:text="الكل"
						android:textSize="13sp"
						android:textStyle="bold"
						android:minWidth="76dp"
						android:paddingStart="18dp"
						android:paddingEnd="18dp"
						android:tag="gold" />
					<TextView
						android:id="@+id/fltUnread"
						android:layout_width="wrap_content"
						android:layout_height="38dp"
						android:gravity="center_horizontal|center_vertical"
						android:text="غير المقروءة"
						android:textSize="13sp"
						android:textStyle="bold"
						android:paddingStart="18dp"
						android:paddingEnd="18dp"
						android:layout_marginStart="8dp"
						android:tag="goldo" />
				</LinearLayout>
				<ScrollView
					android:id="@+id/vscroll39"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:fillViewport="true">
					<LinearLayout
						android:id="@+id/chatList"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:paddingStart="6dp"
						android:paddingEnd="6dp"
						android:paddingTop="2dp"
						android:paddingBottom="96dp"
						android:clipToPadding="false"
						android:orientation="vertical" />
				</ScrollView>
			</LinearLayout>
			<TextView
				android:id="@+id/newGroupFab"
				android:layout_width="58dp"
				android:layout_height="58dp"
				android:layout_margin="16dp"
				android:gravity="center_horizontal|center_vertical"
				android:text=""
				android:drawableStart="@drawable/ic_group_24"
				android:textSize="22sp"
				android:textColor="#FFFFFF"
				android:layout_gravity="bottom|left"
				android:elevation="8dp"
				android:tag="fab" />
			<LinearLayout
				android:id="@+id/searchView"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:orientation="vertical"
				android:visibility="gone"
				android:tag="bg">
				<LinearLayout
					android:id="@+id/linear605"
					android:layout_width="match_parent"
					android:layout_height="56dp"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:tag="sf"
					android:elevation="3dp">
					<TextView
						android:id="@+id/searchBack"
						android:layout_width="52dp"
						android:layout_height="match_parent"
						android:gravity="center_horizontal|center_vertical"
						android:text=""
						android:drawableStart="@drawable/ic_arrow_back_24"
						android:textSize="24sp"
						android:tag="t" />
					<TextView
						android:id="@+id/textview622"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="بحث المستخدمين"
						android:textSize="18sp"
						android:textStyle="bold"
						android:tag="t" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/linear606"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="12dp"
					android:orientation="vertical">
					<EditText
						android:id="@+id/searchInput"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:textSize="14sp"
						android:hint="ابحث بـ \@username"
						android:singleLine="true"
						android:minHeight="48dp"
						android:paddingStart="14dp"
						android:paddingEnd="14dp"
						android:tag="inp"
						android:textDirection="ltr" />
					<TextView
						android:id="@+id/searchHint"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="6dp"
						android:text="اكتب 3 أحرف على الأقل"
						android:textSize="12sp"
						android:tag="m" />
				</LinearLayout>
				<ScrollView
					android:id="@+id/vscroll40"
					android:layout_width="match_parent"
					android:layout_height="match_parent">
					<LinearLayout
						android:id="@+id/searchResults"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical" />
				</ScrollView>
			</LinearLayout>
		</FrameLayout>
		<LinearLayout
			android:id="@+id/bottomNav"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:tag="sf"
			android:elevation="8dp">
			<View
				android:id="@+id/bottomNavLine"
				android:layout_width="match_parent"
				android:layout_height="1dp"
				android:tag="line" />
			<LinearLayout
				android:id="@+id/bottomNavRow"
				android:layout_width="match_parent"
				android:layout_height="75dp"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:paddingStart="10dp"
				android:paddingEnd="10dp"
				android:paddingTop="6dp"
				android:paddingBottom="6dp">
			<LinearLayout
				android:id="@+id/navChats"
				android:layout_width="0dp"
				android:layout_height="63dp"
				android:layout_weight="1"
				android:layout_marginStart="3dp"
				android:layout_marginEnd="3dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical"
				android:clickable="true"
				android:focusable="true">
				<TextView
					android:id="@+id/navChatsIc"
					android:layout_width="56dp"
					android:layout_height="27dp"
					android:gravity="center_horizontal|center_vertical"
					android:text=""
					android:drawableStart="@drawable/ic_chat_22"
					android:textSize="20sp"
					android:tag="m" />
				<TextView
					android:id="@+id/navChatsTx"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:text="المحادثات"
					android:textSize="11sp"
					android:textStyle="bold"
					android:tag="m" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/navSettings"
				android:layout_width="0dp"
				android:layout_height="63dp"
				android:layout_weight="1"
				android:layout_marginStart="3dp"
				android:layout_marginEnd="3dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical"
				android:clickable="true"
				android:focusable="true">
				<TextView
					android:id="@+id/navSettingsIc"
					android:layout_width="56dp"
					android:layout_height="27dp"
					android:gravity="center_horizontal|center_vertical"
					android:text=""
					android:drawableStart="@drawable/ic_settings_22"
					android:textSize="20sp"
					android:tag="m" />
				<TextView
					android:id="@+id/navSettingsTx"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:text="الإعدادات"
					android:textSize="11sp"
					android:textStyle="bold"
					android:tag="m" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/navProfile"
				android:layout_width="0dp"
				android:layout_height="63dp"
				android:layout_weight="1"
				android:layout_marginStart="3dp"
				android:layout_marginEnd="3dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical"
				android:clickable="true"
				android:focusable="true">
				<TextView
					android:id="@+id/navProfileIc"
					android:layout_width="56dp"
					android:layout_height="27dp"
					android:gravity="center_horizontal|center_vertical"
					android:text=""
					android:drawableStart="@drawable/ic_user_22"
					android:textSize="20sp"
					android:tag="m" />
				<TextView
					android:id="@+id/navProfileTx"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:text="الملف الشخصي"
					android:textSize="11sp"
					android:textStyle="bold"
					android:tag="m" />
			</LinearLayout>
			</LinearLayout>
		</LinearLayout>
	</LinearLayout>
	<LinearLayout
		android:id="@+id/chatView"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical"
		android:visibility="gone"
		android:tag="bg">
		<LinearLayout
			android:id="@+id/linear607"
			android:layout_width="match_parent"
			android:layout_height="64dp"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:paddingStart="10dp"
			android:paddingEnd="10dp"
			android:tag="chatbg">
			<TextView
				android:id="@+id/chatBack"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:gravity="center"
				android:text=""
				android:drawableStart="@drawable/ic_arrow_back_24"
				android:textSize="22sp"
				android:elevation="3dp"
				android:tag="rbtn t" />
			<LinearLayout
				android:id="@+id/chatUserInfo"
				android:layout_width="0dp"
				android:layout_height="48dp"
				android:layout_weight="1"
				android:layout_marginStart="8dp"
				android:layout_marginEnd="8dp"
				android:paddingStart="8dp"
				android:paddingEnd="14dp"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:elevation="3dp"
				android:tag="pill">
				<TextView
					android:id="@+id/chatAvatar"
					android:layout_width="42dp"
					android:layout_height="42dp"
					android:gravity="center_horizontal|center_vertical"
					android:text="؟"
					android:textSize="16sp"
					android:textStyle="bold"
					android:textColor="#17212B"
					android:tag="circ" />
				<LinearLayout
					android:id="@+id/linear608"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:layout_marginStart="10dp">
					<TextView
						android:id="@+id/chatTitle"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="المحادثة"
						android:textSize="16sp"
						android:textStyle="bold"
						android:tag="t" />
					<TextView
						android:id="@+id/chatSub"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="غير متصل"
						android:textSize="12sp"
						android:tag="m" />
				</LinearLayout>
			</LinearLayout>
			<TextView
				android:id="@+id/chatMore"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:gravity="center"
				android:text=""
				android:drawableStart="@drawable/ic_more_22"
				android:textSize="22sp"
				android:elevation="3dp"
				android:tag="rbtn t" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/chatSearchPanel"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="10dp"
			android:orientation="vertical"
			android:visibility="gone"
			android:tag="sf">
			<LinearLayout
				android:id="@+id/linear609"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">
				<EditText
					android:id="@+id/chatMessageSearchInput"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:textSize="14sp"
					android:hint="ابحث في هذه المحادثة..."
					android:singleLine="true"
					android:layout_weight="1"
					android:minHeight="48dp"
					android:paddingStart="14dp"
					android:paddingEnd="14dp"
					android:tag="inp" />
				<TextView
					android:id="@+id/csX"
					android:layout_width="44dp"
					android:layout_height="44dp"
					android:gravity="center_horizontal|center_vertical"
					android:text=""
					android:drawableStart="@drawable/ic_close_22"
					android:textSize="20sp"
					android:tag="t" />
			</LinearLayout>
			<TextView
				android:id="@+id/csCount"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:textSize="12sp"
				android:tag="m" />
		</LinearLayout>
		<ScrollView
			android:id="@+id/messagesScroll"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1"
			android:fillViewport="true"
			android:tag="chatbg chatpat">
			<LinearLayout
				android:id="@+id/messagesArea"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="10dp"
				android:orientation="vertical" />
		</ScrollView>
		<LinearLayout
			android:id="@+id/replyPreviewBar"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="8dp"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:visibility="gone"
			android:tag="sf">
			<LinearLayout
				android:id="@+id/linear610"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:layout_weight="1">
				<TextView
					android:id="@+id/replyLabel"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="الرد على الرسالة"
					android:drawableStart="@drawable/ic_reply_16"
					android:drawablePadding="6dp"
					android:textSize="12sp"
					android:textStyle="bold"
					android:tag="g" />
				<TextView
					android:id="@+id/replyPreviewText"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="..."
					android:textSize="13sp"
					android:tag="m"
					android:maxLines="1"
					android:ellipsize="end" />
			</LinearLayout>
			<TextView
				android:id="@+id/replyCancel"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:gravity="center_horizontal|center_vertical"
				android:text=""
				android:drawableStart="@drawable/ic_close_20"
				android:textSize="18sp"
				android:tag="m" />
		</LinearLayout>
		<!-- شريط التسجيل الصوتي (مطابق لـ #recordingBar في الـ HTML): إلغاء | حالة + مؤقّت + موجة | إيقاف أو إرسال -->
		<LinearLayout
			android:id="@+id/recordingBar"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:minHeight="66dp"
			android:paddingStart="12dp"
			android:paddingEnd="12dp"
			android:paddingTop="8dp"
			android:paddingBottom="8dp"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:visibility="gone"
			android:tag="recbar">
			<LinearLayout
				android:id="@+id/recLeft"
				android:layout_width="38dp"
				android:layout_height="wrap_content"
				android:paddingTop="3dp"
				android:paddingBottom="3dp"
				android:gravity="center_horizontal"
				android:orientation="vertical"
				android:tag="recgold12">
				<TextView
					android:id="@+id/recCancel"
					android:layout_width="38dp"
					android:layout_height="36dp"
					android:gravity="center_horizontal|center_vertical"
					android:text=""
					android:drawableStart="@drawable/ic_close_20"
					android:contentDescription="إلغاء التسجيل"
					android:tag="wh" />
				<TextView
					android:id="@+id/recPlay"
					android:layout_width="38dp"
					android:layout_height="23dp"
					android:gravity="center_horizontal|center_vertical"
					android:text=""
					android:drawableStart="@drawable/ic_play_20"
					android:contentDescription="تشغيل التسجيل"
					android:visibility="gone"
					android:tag="wh" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/recLive"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:layout_marginStart="12dp"
				android:layout_marginEnd="12dp"
				android:orientation="vertical">
				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<View
						android:id="@+id/recDot"
						android:layout_width="7dp"
						android:layout_height="7dp" />
					<TextView
						android:id="@+id/recText"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:layout_marginStart="7dp"
						android:text="جاري التسجيل"
						android:textSize="12sp"
						android:textStyle="bold" />
					<TextView
						android:id="@+id/recTimer"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="00:00"
						android:textSize="12sp"
						android:tag="m" />
				</LinearLayout>
				<com.babylon.chat.iq.VoiceWaveView
					android:id="@+id/recWave"
					android:layout_width="match_parent"
					android:layout_height="33dp"
					android:layout_marginTop="4dp"
					android:tag="recwave" />
			</LinearLayout>
			<TextView
				android:id="@+id/recStop"
				android:layout_width="42dp"
				android:layout_height="42dp"
				android:gravity="center_horizontal|center_vertical"
				android:text=""
				android:drawableStart="@drawable/ic_stop_18"
				android:contentDescription="إيقاف التسجيل"
				android:tag="recgoldc" />
			<TextView
				android:id="@+id/recSend"
				android:layout_width="42dp"
				android:layout_height="42dp"
				android:gravity="center_horizontal|center_vertical"
				android:text=""
				android:drawableStart="@drawable/ic_arrow_send_21"
				android:contentDescription="إرسال التسجيل"
				android:visibility="gone"
				android:tag="recgoldc recsend" />
		</LinearLayout>
		<!-- حقل الكتابة: بطاقة + حقل بزوايا 10dp + (إرفاق/مايك) أو زر إرسال ذهبي عند وجود نص فقط -->
		<LinearLayout
			android:id="@+id/textInputBar"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginStart="10dp"
			android:layout_marginEnd="10dp"
			android:layout_marginTop="4dp"
			android:layout_marginBottom="6dp"
			android:paddingStart="8dp"
			android:paddingEnd="8dp"
			android:paddingTop="6dp"
			android:paddingBottom="6dp"
			android:orientation="horizontal"
			android:tag="composer"
			android:elevation="6dp">
			<EditText
				android:id="@+id/messageInput"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:layout_gravity="bottom"
				android:background="@null"
				android:gravity="start|center_vertical"
				android:hint="اكتب رسالتك..."
				android:inputType="textMultiLine|textCapSentences"
				android:minHeight="42dp"
				android:maxHeight="132dp"
				android:paddingStart="12dp"
				android:paddingEnd="12dp"
				android:paddingTop="10dp"
				android:paddingBottom="10dp"
				android:textSize="15sp"
				android:tag="cinp" />
			<TextView
				android:id="@+id/btnAttach"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:layout_marginStart="6dp"
				android:layout_gravity="bottom"
				android:gravity="center_horizontal|center_vertical"
				android:text=""
				android:drawableStart="@drawable/ic_attach_22"
				android:contentDescription="وسائط"
				android:tag="m" />
			<TextView
				android:id="@+id/btnMic"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:layout_marginStart="6dp"
				android:layout_gravity="bottom"
				android:gravity="center_horizontal|center_vertical"
				android:text=""
