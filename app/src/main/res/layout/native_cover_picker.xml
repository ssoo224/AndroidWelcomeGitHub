<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/nativeCoverPicker" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/bg_native_sheet" android:layoutDirection="rtl">
 <View android:layout_width="42dp" android:layout_height="4dp" android:layout_gravity="center_horizontal" android:background="@drawable/bg_gesture_handle"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="غلاف ملفك الشخصي" android:textColor="#F8FAFC" android:textSize="19sp" android:textStyle="bold"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="اختر اللون الذي يعبر عنك" android:textColor="#94A3B8" android:textSize="13sp"/>
 <GridLayout android:id="@+id/coverColorGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="3" android:rowCount="2" android:useDefaultMargins="true" android:layout_marginTop="18dp">
  <TextView android:id="@+id/coverColor0" android:layout_width="0dp" android:layout_height="72dp" android:layout_columnWeight="1" android:background="#1B2A4A" android:gravity="center" android:text="✓" android:textColor="#FFFFFF" android:textSize="22sp"/>
  <TextView android:id="@+id/coverColor1" android:layout_width="0dp" android:layout_height="72dp" android:layout_columnWeight="1" android:background="#3B2A4A"/>
  <TextView android:id="@+id/coverColor2" android:layout_width="0dp" android:layout_height="72dp" android:layout_columnWeight="1" android:background="#0F5132"/>
  <TextView android:id="@+id/coverColor3" android:layout_width="0dp" android:layout_height="72dp" android:layout_columnWeight="1" android:background="#7C2D12"/>
  <TextView android:id="@+id/coverColor4" android:layout_width="0dp" android:layout_height="72dp" android:layout_columnWeight="1" android:background="#334155"/>
  <TextView android:id="@+id/coverColor5" android:layout_width="0dp" android:layout_height="72dp" android:layout_columnWeight="1" android:background="#B8891A"/>
 </GridLayout>
 <TextView android:id="@+id/coverPickerCancel" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="12dp" android:gravity="center" android:text="إغلاق" android:textColor="#E2E8F0" android:background="@drawable/bg_native_input"/>
</LinearLayout>
