<?xml version="1.0" encoding="utf-8"?>
<!-- نقطة التحميل رقم 3: موجة متصلة — كل نقطة تبدأ مباشرة حين تبدأ السابقة بالانطفاء (1 ← 2 ← 3 ← 1 ...) بلا فراغ بينها -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="1200"
    android:startDelay="600"
    android:repeatCount="-1"
    android:repeatMode="restart">
    <propertyValuesHolder android:propertyName="alpha" android:valueType="floatType">
        <keyframe android:fraction="0" android:value="0.3" />
        <keyframe android:fraction="0.25" android:value="1" android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe android:fraction="0.5" android:value="0.3" android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe android:fraction="1" android:value="0.3" />
    </propertyValuesHolder>
    <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
        <keyframe android:fraction="0" android:value="0.8" />
        <keyframe android:fraction="0.25" android:value="1.15" android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe android:fraction="0.5" android:value="0.8" android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe android:fraction="1" android:value="0.8" />
    </propertyValuesHolder>
    <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
        <keyframe android:fraction="0" android:value="0.8" />
        <keyframe android:fraction="0.25" android:value="1.15" android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe android:fraction="0.5" android:value="0.8" android:interpolator="@android:interpolator/accelerate_decelerate" />
        <keyframe android:fraction="1" android:value="0.8" />
    </propertyValuesHolder>
</objectAnimator>
