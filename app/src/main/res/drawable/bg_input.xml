<?xml version="1.0" encoding="utf-8"?>
<!-- الطور النهاري: بلا إطار؛ ظل خفيف جداً حول الكبسولة للتمييز فقط (الليلي يضع goldBox من الكود) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A17212B" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item
        android:left="0.5dp"
        android:top="0.5dp"
        android:right="0.5dp"
        android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFDFA" />
            <corners android:radius="25.5dp" />
        </shape>
    </item>
</layer-list>
